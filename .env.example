# ============================================================================
# Cross-Compatibility Test Environment (Example)
# ============================================================================
# Copy this to .env and fill in your actual credentials:
#   cp .env.example .env
#
# Then source it before running tests:
#   source .env
# ============================================================================

# ----------------------------------------------------------------------------
# Repo root (auto-resolved)
# ----------------------------------------------------------------------------
# Resolves the repo root from this file's own location, so the test prompts can
# reference $REPO_ROOT regardless of which directory you source from or cd into.
export REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# ----------------------------------------------------------------------------
# AWS / Bedrock (for Claude Code agent runtime)
# ----------------------------------------------------------------------------
export AWS_REGION="us-east-2"
export AWS_BEARER_TOKEN_BEDROCK="your-bedrock-token-here"
export CLAUDE_CODE_USE_BEDROCK=1

# ----------------------------------------------------------------------------
# Hugging Face (for model downloads)
# ----------------------------------------------------------------------------
export HUGGING_FACE_HUB_TOKEN="your-hf-token-here"
export HF_TOKEN="$HUGGING_FACE_HUB_TOKEN"

# ============================================================================
# MODEL SERVING ENDPOINTS
# ============================================================================

# Chat/Text Models
export LLM_BASE_URL="http://localhost:8000/v1"
export LLM_API_KEY="not-needed-for-local"
export LLM_MODEL="Qwen/Qwen2.5-1.5B-Instruct"

# Embeddings
export EMBED_BASE_URL="http://localhost:8001/v1"
export EMBED_API_KEY="not-needed-for-local"
export EMBED_MODEL="BAAI/bge-small-en-v1.5"

# Vision Models
export VISION_BASE_URL="http://localhost:8002/v1"
export VISION_API_KEY="not-needed-for-local"
export VISION_MODEL="Qwen/Qwen2-VL-2B-Instruct"

# Image Generation
export IMAGE_BASE_URL="http://localhost:7860"

# ============================================================================
# XPU RUNTIME CONFIGURATION
# ============================================================================

export ZE_AFFINITY_MASK="0"
export VLLM_WORKER_MULTIPROC_METHOD="spawn"

# Per-user cache, not a shared /tmp path: a fixed name under /tmp is
# predictable and world-traversable, so on a multi-user host it invites
# collisions and symlink games from other accounts.
export TRITON_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/triton"
